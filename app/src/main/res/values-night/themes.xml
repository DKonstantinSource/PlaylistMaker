<resources>
    <style name="Base.Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorBlackBackground</item>
        <item name="colorOnPrimary">@color/colorWhiteText</item>
        <item name="colorSecondaryVariant">@color/colorBlackBackground</item>
        <item name="colorSecondary">@color/colorWhiteText</item>
        <item name="colorOnSecondary">@color/colorWhiteText</item>
        <item name="colorAccent">@color/firstTextColor</item>
        <item name="colorTertiary">@color/colorWhiteBackground</item>
        <item name="colorPrimaryFixed">@color/mainBackground</item>
        <item name="colorOnContainer">@color/colorWhiteBackground</item>
        <item name="colorSurfaceDim">@color/colorWhiteText</item>
        <item name="colorBackgroundFloating">@color/colorWhiteText</item>
        <item name="trackColor">@color/switch_track_dark</item>
        <item name="thumbColor">@color/switch_thumb_dark</item>
        <item name="colorOnSurfaceVariant">@color/bottom_nav_item_color_night</item>
        <item name="colorTertiaryFixed">#E6E8EB</item>
        <item name="colorPrimaryFixedDim">#FFFFFF</item>

        <item name="alertDialogTheme">@style/CustomMaterialDialog</item>

    </style>

    <style name="CustomMaterialDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButtonStyle</item>
    </style>

    <style name="DialogButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">?attr/colorOnSecondary</item>
    </style>

    <style name="buttonBarPositiveButtonStyle">
        <item name="textAllCaps">false</item>
        <item name="android:textColor">@color/colorWhiteText</item>
    </style>

    <style name="buttonBarNegativeButtonStyle">
        <item name="textAllCaps">false</item>
        <item name="android:textColor">@color/colorWhiteText</item>
    </style>


    <style name="Theme.MyAppPlaylistMaker" parent="Base.Theme.PlaylistMaker">
        <item name="snackbarStyle">@style/Widget.App.CustomSnackbar</item>
    </style>

    <style name="title">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="TransparentButton">
        <item name="android:background">#80FF0000</item>
        <item name="android:alpha">0</item>
    </style>


</resources>