<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical"
    android:backgroundTint="?attr/colorPrimary">

    <ImageView
        android:id="@+id/playlistImageSheet"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:src="@drawable/image_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp">

        <TextView
            android:id="@+id/playlistNameSheet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Playlist Name"
            android:textSize="16sp"
            android:textColor="?attr/colorSurfaceDim"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/playlistTrackCountSheet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 треков"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimaryFixedDim" />
    </LinearLayout>
</LinearLayout>