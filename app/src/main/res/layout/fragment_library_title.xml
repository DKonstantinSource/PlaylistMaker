<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:id="@+id/libraryTitleFragment"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp"
    tools:context=".presentation.fragments.media_library.FragmentPlaylist"
    xmlns:tools="http://schemas.android.com/tools">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        style="@style/smallContainerSetting">


        <TextView
            android:layout_marginStart="@dimen/mainCornerRadiusBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/media_library"
            android:fontFamily="@font/ys_display_medium"
            android:textSize="@dimen/headerTextSize"
            android:textFontWeight="500"
            android:textColor="?attr/colorOnSecondary" />


    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragment_title_child_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="62dp" />


</FrameLayout>
