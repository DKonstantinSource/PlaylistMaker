<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.fragments.media_library.PlayListsFragment">

    <LinearLayout

        android:id="@+id/noOnePlayLists"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton

            android:id="@+id/newPlayList"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/button_on_refresh"
            android:backgroundTint="@color/black"
            android:textAlignment="center"
            android:text="@string/new_playlist"
            style="@style/buttonNewPlayList">

        </com.google.android.material.button.MaterialButton>

        <ImageView
            android:id="@+id/emptyPlayListImage"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="46dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/image_no_song" />

        <TextView
            android:id="@+id/emptyPlayListText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textFontWeight="400"
            android:fontFamily="@font/ys_display_medium"
            android:text="@string/media_library_playlists_is_empty"
            android:textSize="@dimen/text_on_error"
            android:layout_marginBottom="@dimen/mainCornerRadiusBtn"
            android:textColor="?attr/colorOnSecondary"
            android:textAlignment="center"
            android:maxLines="2"></TextView>

    </LinearLayout>

</FrameLayout>