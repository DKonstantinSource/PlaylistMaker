<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.fragments.media_library.FavoriteTracksFragment">

    <LinearLayout
        android:id="@+id/noOneTrackOnLibrary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView

            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="106dp"
            android:layout_marginBottom="@dimen/mainCornerRadiusBtn"
            android:src="@drawable/image_no_song" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ys_display_medium"
            android:text="@string/media_library_is_empty"
            android:textSize="@dimen/text_on_error"
            android:textFontWeight="500"
            android:layout_marginBottom="@dimen/mainCornerRadiusBtn"
            android:textColor="?attr/colorOnSecondary"
            android:textAlignment="center"></TextView>

    </LinearLayout>

</FrameLayout>