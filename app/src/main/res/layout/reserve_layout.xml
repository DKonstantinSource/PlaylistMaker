<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mediaMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    style="@style/backgroundColorSettings">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        style="@style/backgroundColorSettings">


        <LinearLayout
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            style="@style/smallContainerSetting">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:src="@drawable/button_back_light"
                style="@style/buttonDarkTheme" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/media_library"
                android:fontFamily="@font/ys_display_medium"
                android:textSize="@dimen/headerTextSize"
                android:textFontWeight="500"
                android:textColor="?attr/colorOnSecondary" />

        </LinearLayout>

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:orientation="vertical">

            <com.google.android.material.tabs.TabLayout
                android:visibility="visible"
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="@font/ys_display_medium"
                android:textSize="@dimen/small_text_size"
                app:tabTextColor="?attr/colorOnSecondary"
                android:background="?attr/colorPrimary"
                app:tabMode="fixed" />

            <androidx.viewpager2.widget.ViewPager2
                android:visibility="visible"
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorPrimary" />


        </LinearLayout>

        <LinearLayout

            android:id="@+id/noOnePlayLists"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton

                android:id="@+id/newPlayList"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/button_on_refresh"
                android:backgroundTint="@color/black"
                android:textAlignment="center"
                android:text="@string/new_playlist"
                style="@style/buttonNewPlayList">

            </com.google.android.material.button.MaterialButton>

            <ImageView
                android:id="@+id/emptyPlayListImage"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="46dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/image_no_song" />

            <TextView
                android:id="@+id/emptyPlayListText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textFontWeight="400"
                android:fontFamily="@font/ys_display_medium"
                android:text="@string/media_library_playlists_is_empty"
                android:textSize="@dimen/text_on_error"
                android:layout_marginBottom="@dimen/mainCornerRadiusBtn"
                android:textColor="?attr/colorOnSecondary"
                android:textAlignment="center"></TextView>

        </LinearLayout>


        <LinearLayout
            android:visibility="gone"
            android:id="@+id/noOneTrackOnLibrary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView

                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="106dp"
                android:layout_marginBottom="@dimen/mainCornerRadiusBtn"
                android:src="@drawable/image_no_song" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ys_display_medium"
                android:text="@string/media_library_is_empty"
                android:textSize="@dimen/text_on_error"
                android:textFontWeight="500"
                android:layout_marginBottom="@dimen/mainCornerRadiusBtn"
                android:textColor="?attr/colorOnSecondary"
                android:textAlignment="center" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>