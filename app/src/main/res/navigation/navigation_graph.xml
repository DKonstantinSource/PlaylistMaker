<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/libraryTitleFragment">

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.playlistmaker.presentation.fragments.search.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search">

        <action
            android:id="@+id/action_searchFragment_to_fragmentPlayer"
            app:destination="@id/fragmentPlayer" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragmentScreen"
        android:name="com.example.playlistmaker.presentation.fragments.settings.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/libraryTitleFragment"
        android:name="com.example.playlistmaker.presentation.fragments.media_library.tab_layout.FragmentsHostLibrary"
        android:label="fragment_library"
        tools:layout="@layout/fragment_library_title">

        <action
            android:id="@+id/action_libraryTitleFragment_to_fragmentPlayer"
            app:destination="@id/fragmentPlayer" />

        <action
            android:id="@+id/action_libraryTitleFragment_to_fragmentEnterPlaylist"
            app:destination="@id/fragmentEnterPlaylist" />
    </fragment>

    <fragment
        android:id="@+id/fragmentPlayListAdd"
        android:name="com.example.playlistmaker.presentation.fragments.media_library.playlist.add_playlist.FragmentPlayListAdd"
        android:label="fragment_playlist_add"
        tools:layout="@layout/fragment_playlist_add" />

    <fragment
        android:id="@+id/fragmentPlayer"
        android:name="com.example.playlistmaker.presentation.fragments.player.FragmentPlayer"
        android:label="fragment_player"
        tools:layout="@layout/fragment_player">

        <action
            android:id="@+id/action_fragment_Player_to_fragmentPlayListAdd"
            app:destination="@id/fragmentPlayListAdd" />
    </fragment>

    <fragment
        android:id="@+id/fragmentEnterPlaylist"
        android:name="com.example.playlistmaker.presentation.fragments.media_library.playlist.playlist_fragment.enter.FragmentEnterPlaylist"
        android:label="Playlist"
        tools:layout="@layout/fragment_enter_playlist">
        <action
            android:id="@+id/action_fragmentEnterPlaylist_to_audioPlayerFragment"
            app:destination="@id/fragmentPlayer">
            <argument
                android:name="trackId"
                app:argType="long" />
        </action>

    </fragment>

</navigation>
