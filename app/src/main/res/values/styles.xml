<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="mainButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/colorBlackText</item>
        <item name="android:textSize">@dimen/headerTextSize</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_weight">1</item>
        <item name="backgroundTint">?attr/colorOnPrimary</item>
        <item name="cornerRadius">@dimen/mainCornerRadiusBtn</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/mainIconPadding</item>
        <item name="iconTint">@color/colorBlackText</item>
        <item name="font">@font/ys_display_medium</item>
    </style>
    <style name="backgroundColorSettings">
        <item name="android:background">?attr/colorPrimary</item>
    </style>
    <style name="appNameMain">
        <item name="android:text">@string/title</item>
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">@dimen/headerTextSize</item>
        <item name="font">@font/ys_display_medium</item>
    </style>
    <style name="smallContainerSetting">
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="android:textSize">@dimen/normalTextSize</item>
        <item name="font">@font/ys_display_regular</item>

        <item name="android:thumbTint">@color/switch_thumb_color</item>
        <item name="android:trackTint">@color/switch_track_color</item>

    </style>
    <style name="buttonDarkTheme">
        <item name="android:iconTint">?attr/colorPrimary</item>
        <item name="android:backgroundTint">?attr/colorPrimary</item>
        <item name="android:background">?attr/colorPrimary</item>
    </style>
    <style name="titleSettings">
        <item name="android:backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="font">@font/ys_display_medium</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:text">@string/settings</item>
        <item name="android:textSize">@dimen/headerTextSize</item>
        <item name="android:background">?attr/colorPrimary</item>
    </style>
    <style name="titleSearch">
        <item name="android:backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="font">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:text">@string/titleSearch</item>
        <item name="android:textSize">@dimen/headerTextSize</item>
        <item name="android:background">?attr/colorPrimary</item>
    </style>

    <style name="backgroundColorMain">
        <item name="android:orientation">vertical</item>
        <item name="android:background">?attr/colorSecondaryVariant</item>
    </style>
    <style name="searchField">
        <item name="android:textColorHint">?attr/colorOnSecondary</item>
        <item name="cornerRadius">@dimen/mainIconPadding</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/mainIconPadding</item>
        <item name="iconTint">@color/colorBlackText</item>
        <item name="font">@font/ys_display_medium</item>
    </style>


    <style name="trackName">
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">@dimen/normalTextSize</item>
        <item name="android:textColor">?attr/colorTertiary</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="trackDescription" >
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">@dimen/track_description_11dp</item>
        <item name="android:textColor">?attr/colorOnContainer</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    
    <style name="errorText">
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">@dimen/text_on_error</item>
        <item name="font">@font/ys_display_medium</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="refreshButton">
        <item name="android:layout_gravity">center</item>
        <item name="android:backgroundTint">?attr/colorOnSecondary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:text">@string/textOnRefresh</item>
        <item name="backgroundColor">?attr/colorOnSecondary</item>
    </style>

    <style name="errorPlaceholder">
        <item name="android:tint">?attr/colorTertiary</item>

    </style>

    <style name="prevSearch">
        <item name="android:layout_gravity">center</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="android:text">@string/prevSearch</item>
        <item name="android:fontWeight">500</item>
        <item name="android:textAlignment">center</item>
        <item name="android:font">@font/ys_display_medium</item>
        <item name="android:textSize">19sp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">@dimen/mainIconPadding</item>
    </style>
    <style name="buttonRefreshHistory" >
        <item name="backgroundTint">?attr/colorTertiary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:text">@string/clearHistory</item>
        <item name="android:layout_gravity">bottom</item>
        <item name="android:gravity">center</item>
        <item name="android:font">@font/ys_display_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontWeight">500</item>
        <item name="textAllCaps">false</item>
        <item name="lineHeight">16.41dp</item>
        <item name="cornerRadius">@dimen/corner_radius_dp</item>
    </style>

    <style name="TrackContentTitle">
        <item name="android:layout_marginTop">@dimen/mainIconPadding</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">@color/ic_cross_color</item>
        <item name="android:fontWeight">400</item>
        <item name="android:textSize">@dimen/content_description_footer</item>
    </style>

    <style name="TrackContent">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">?attr/colorSurfaceDim</item>
        <item name="android:fontWeight">400</item>
        <item name="android:textSize">@dimen/content_description_footer</item>
        <item name="android:gravity">end</item>
    </style>

    <style name="buttonNewPlayList">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:gravity">center</item>
        <item name="android:font">@font/ys_display_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontWeight">500</item>
        <item name="textAllCaps">false</item>
        <item name="cornerRadius">@dimen/corner_radius_dp</item>
    </style>

    <style name="PlaylistItem">
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">?attr/colorBackgroundFloating</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/CustomShapeAppearance</item>
    </style>

    <style name="CustomShapeAppearance">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>


    <style name="CustomShapeImage" parent="@style/ThemeOverlay.MaterialComponents">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/size8dp</item>
    </style>

    <style name="ThemeOverlay.CustomSnackbar" parent="ThemeOverlay.MaterialComponents">
        <item name="snackbarStyle">@style/Widget.App.CustomSnackbar</item>
    </style>

    <style name="Widget.App.CustomSnackbar" parent="@style/Widget.MaterialComponents.Snackbar">
        <item name="backgroundTint">?attr/colorAccent</item>
        <item name="android:layout_margin">@dimen/size6dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.CustomSnackbar</item>
        <item name="snackbarTextViewStyle">@style/TextAppearance.App.CustomSnackbarText</item>

    </style>

    <style name="ShapeAppearance.CustomSnackbar" parent="@style/ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="height">@dimen/size48dp</item>
        <item name="android:width">@dimen/size345dp</item>
        <item name="cornerRadius">@dimen/size0</item>
    </style>

    <style name="TextAppearance.App.CustomSnackbarText" parent="@style/TextAppearance.MaterialComponents.Body2">
        <item name="android:layout_width">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>

    </style>

    <style name="CustomMaterialDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButtonStyle</item>
    </style>


</resources>
