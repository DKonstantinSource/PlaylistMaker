<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar" >
        <item name="colorPrimary">@color/colorWhiteBackground</item>
        <item name="colorOnPrimary">@color/colorWhiteBackground</item>
        <item name="colorSecondaryVariant">@color/mainBackground</item>
        <item name="colorSecondary">@color/colorWhiteText</item>
        <item name="colorOnSecondary">@color/colorBlackText</item>
        <item name="colorAccent">@color/ic_cross_color</item>
        <item name="colorTertiary">@color/backArrow</item>
        <item name="colorPrimaryFixed">@color/mainBackground</item>
        <item name="colorOnContainer">@color/artist_track_text_color</item>
        <item name="colorSurfaceDim">@color/backArrow</item>
        <item name="colorBackgroundFloating">@color/colorBlackText</item>
        <item name="trackColor">@color/switch_track_light</item>
        <item name="thumbColor">@color/switch_thumb_light</item>
        <item name="colorOnSurfaceVariant">@color/bottom_nav_item_color</item>
        <item name="colorPrimaryFixedDim">#AEAFB4</item>
        <item name="alertDialogTheme">@style/CustomMaterialDialog</item>

    </style>>

    <style name="CustomDialogTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="buttonBarPositiveButtonStyle">@style/buttonBarPositiveButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/buttonBarNegativeButtonStyle</item>
    </style>

    <style name="buttonBarPositiveButtonStyle">
        <item name="textAllCaps">false</item>
        <item name="android:textColor">@color/colorBlackText</item>
    </style>

    <style name="buttonBarNegativeButtonStyle">
        <item name="textAllCaps">false</item>
        <item name="android:textColor">@color/colorBlackText</item>
    </style>


    <style name="Theme.MyAppPlaylistMaker" parent="Base.Theme.PlaylistMaker">
        <item name="snackbarStyle">@style/Widget.App.CustomSnackbar</item>
    </style>

    <style name="title">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="TransparentButton">
        <item name="android:background">#80FF0000</item>
        <item name="android:alpha">0</item>
    </style>


</resources>